<div class="container mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Overview Page</h1>

    <div class="grid grid-cols-1 gap-8">
      <div class="bg-gray-50 rounded-lg p-4">
        <h2 class="text-xl font-semibold mb-4">Success Rate Over Time</h2>
        <%= line_chart @chart_data,
                      height: '400px',
                      library: {
                        yAxis: {
                          title: { text: 'Success Rate (%)' },
                          max: 100,
                          min: 0
                        },
                        tooltip: {
                          valueSuffix: '%'
                        },
                        colors: ['#3B82F6']
                      } %>

      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-blue-50 p-4 rounded-lg">
          <h3 class="font-medium text-blue-800">Total Scrapes</h3>
          <p class="text-3xl font-bold"><%= @success_rates.sum { |r| r[2] } %></p>
        </div>
        <div class="bg-green-50 p-4 rounded-lg">
          <h3 class="font-medium text-green-800">Success Rate</h3>
          <p class="text-3xl font-bold">
            <%= number_to_percentage(@success_rates.empty? ? 0 : @chart_data.values.sum / @chart_data.size, precision: 1) %>
          </p>
        </div>
        <div class="bg-red-50 p-4 rounded-lg">
          <h3 class="font-medium text-red-800">Failure Rate</h3>
          <p class="text-3xl font-bold">
            <%= number_to_percentage(@success_rates.empty? ? 0 : 100 - (@chart_data.values.sum / @chart_data.size), precision: 1) %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Error Type Distribution</h2>
  </div>
  <div class="card-content">
    <%= pie_chart @error_distribution,
      height: '400px',
      library: {
        plotOptions: {
          pie: {
            allowPointSelect: true,
            cursor: 'pointer',
            dataLabels: {
              enabled: true,
              format: '<b>{point.name}</b>: {point.percentage:.1f} %'
            }
          }
        },
        colors: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF']
      } %>
  </div>
</div>