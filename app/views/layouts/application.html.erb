<!DOCTYPE html>
<html>
  <head>
    <title>GolfDashboard</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
  </head>

  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">Navbar</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <%= link_to "Overview", overview_analytics_path, class: "nav-link active", "aria-current": "page"  %>
          </li>
          <li class="nav-item">
            <%= link_to "Course", course_analytics_path, class: "nav-link"  %>
          </li>
          <li class="nav-item">
            <%= link_to "Booking System", booking_system_analytics_path, class: "nav-link"  %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <body>
    <%= yield %>
  </body>
</html>
